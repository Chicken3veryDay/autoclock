# Required: bearer token every request must present.
AUTOCLOCK_TOKEN=change-me-to-a-long-random-string

# SQLite path (inside the container this lives on the /data volume).
AUTOCLOCK_DB=/data/autoclock.db

# IANA timezone used for day/week bucketing.
AUTOCLOCK_TZ=UTC

# Geofence blip merge window in minutes.
AUTOCLOCK_DEBOUNCE_MIN=10

# Auto-close an open session after this many hours.
AUTOCLOCK_MAX_SESSION_H=14

# ntfy notifications (leave NTFY_TOPIC empty to disable).
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Base URL your phone uses to reach this server; embedded in notification
# action URLs.
AUTOCLOCK_PUBLIC_URL=https://autoclock.example.com

# Re-send the "who for?" prompt once after this many minutes; 0 disables.
AUTOCLOCK_REMIND_MIN=0

# VAPID contact claim for web push (usually mailto:you@your.domain). The
# VAPID keypair itself is generated on first start and stored next to the
# database; it is never configured here.
# Defaults to AUTOCLOCK_PUBLIC_URL when it is https
#AUTOCLOCK_VAPID_SUBJECT=mailto:you@example.com
